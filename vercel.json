{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "regions": [
    "syd1"
  ],
  "crons": [
    {
      "path": "/api/solis/cleanup",
      "schedule": "0 18 * * *"
    }
  ]
}
